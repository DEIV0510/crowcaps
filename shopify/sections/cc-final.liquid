<!-- ============ CTA FINAL ============ -->
<section class="final" id="contacto">
  <img class="final__mascot" src="{{ 'cc-mascot.webp' | asset_url }}" width="320" height="286" loading="lazy" decoding="async" alt="">
  <h2 class="reveal">{{ section.settings.titulo }}</h2>
  <p class="reveal reveal-d1">{{ section.settings.texto | escape }}</p>
  <a class="btn btn--light reveal reveal-d2" href="#coleccion">{{ section.settings.boton | escape }} <span class="arw" aria-hidden="true">→</span></a>
</section>

{% schema %}
{
  "name": "Cierre",
  "class": "cc-final",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título (admite <br> y <em>)", "default": "¿Ya encontraste<br><em>la tuya?</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Agrégala al carrito y paga con Mercado Pago o contra entrega. Desde 2 gorras, el envío es gratis pagando en línea." },
    { "type": "text", "id": "boton", "label": "Botón a la colección", "default": "Ver colección" }
  ],
  "presets": [{ "name": "Cierre" }]
}
{% endschema %}
