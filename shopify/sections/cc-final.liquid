{%- capture wa_cierre -%}{%- render 'cc-wa', mensaje: settings.mensaje_cierre -%}{%- endcapture -%}
<!-- ============ CTA FINAL ============ -->
<section class="final" id="contacto">
  <img class="final__mascot" src="{{ 'cc-mascot.webp' | asset_url }}" width="320" height="286" loading="lazy" decoding="async" alt="">
  <h2 class="reveal">{{ section.settings.titulo }}</h2>
  <p class="reveal reveal-d1">{{ section.settings.texto | escape }}</p>
  <a class="btn btn--light reveal reveal-d2" href="{{ wa_cierre }}" target="_blank" rel="noopener">{{ settings.texto_pedir | escape }} <span class="arw">→</span></a>
</section>

{% schema %}
{
  "name": "Cierre",
  "class": "cc-final",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título (admite <br> y <em>)", "default": "¿Ya encontraste<br><em>la tuya?</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Escríbenos con el nombre de la gorra y te confirmamos disponibilidad al instante. Desde 2 gorras, el envío es gratis a toda Colombia." }
  ],
  "presets": [{ "name": "Cierre" }]
}
{% endschema %}
