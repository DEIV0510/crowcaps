{%- liquid
  capture wa_general
    render 'cc-wa', mensaje: settings.mensaje_general
  endcapture
  assign raiz = routes.root_url
  if raiz == '/'
    assign raiz = ''
  endif
-%}
<!-- ============ FOOTER ============ -->
<footer class="foot">
  <div class="foot__grid">
    <div>
      <img class="foot__logo" src="{{ 'cc-wordmark-ink.webp' | asset_url }}" width="71" height="26" loading="lazy" decoding="async" alt="{{ settings.marca_nombre | escape }}">
      <p>{{ section.settings.nota | escape }}</p>
    </div>
    <div>
      <h4>{{ section.settings.col2 | escape }}</h4>
      <ul>
        <li><a href="{{ raiz }}/#coleccion">{{ section.settings.col2_l1 | escape }}</a></li>
        <li><a href="{{ raiz }}/#marca">{{ section.settings.col2_l2 | escape }}</a></li>
        <li><a href="{{ raiz }}/#feed">{{ section.settings.col2_l3 | escape }}</a></li>
      </ul>
    </div>
    <div>
      <h4>{{ section.settings.col3 | escape }}</h4>
      <ul>
        <li><a href="{{ wa_general }}" target="_blank" rel="noopener">{{ section.settings.col3_wa | escape }}</a></li>
        <li><a href="{{ raiz }}/#coleccion">{{ section.settings.col3_envio | escape }}</a></li>
      </ul>
    </div>
    <div>
      <h4>{{ section.settings.col4 | escape }}</h4>
      <ul>
        {%- if settings.instagram_visible and settings.instagram_url != blank %}<li><a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">{{ settings.instagram_etiqueta | escape }}</a></li>{% endif %}
        {%- if settings.tiktok_visible and settings.tiktok_url != blank %}<li><a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener">{{ settings.tiktok_etiqueta | escape }}</a></li>{% endif %}
        {%- if settings.facebook_visible and settings.facebook_url != blank %}<li><a href="{{ settings.facebook_url }}" target="_blank" rel="noopener">{{ settings.facebook_etiqueta | escape }}</a></li>{% endif %}
      </ul>
    </div>
  </div>
  <div class="foot__bot">
    <span>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | escape }}</span>
    <span>{{ settings.lema | escape }}</span>
  </div>
</footer>

<a class="wafab" href="{{ wa_general }}" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.09c-.25.69-1.43 1.32-1.98 1.4-.53.08-1.19.11-1.92-.12-.44-.14-1.01-.33-1.74-.64-3.06-1.32-5.05-4.4-5.2-4.6-.15-.2-1.24-1.65-1.24-3.15s.79-2.24 1.07-2.54c.28-.31.61-.38.81-.38.2 0 .41 0 .58.01.19.01.44-.7.69.53.25.6.86 2.1.94 2.25.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.31.39-.45.53-.15.15-.3.31-.13.61.18.3.78 1.29 1.68 2.09 1.16 1.03 2.13 1.35 2.43 1.5.3.15.48.13.66-.08.18-.2.76-.89.96-1.19.2-.3.4-.25.68-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.35.08.13.08.73-.17 1.42Z"/></svg>
</a>

{% schema %}
{
  "name": "Pie de página",
  "class": "cc-footer",
  "settings": [
    { "type": "text", "id": "nota", "label": "Texto bajo el logo", "default": "Medellín, Antioquia, Colombia. Ventas online — no contamos con punto físico." },
    { "type": "text", "id": "col2", "label": "Título columna 2", "default": "Tienda" },
    { "type": "text", "id": "col2_l1", "label": "Enlace 1", "default": "Colección" },
    { "type": "text", "id": "col2_l2", "label": "Enlace 2", "default": "Sobre CrowCaps" },
    { "type": "text", "id": "col2_l3", "label": "Enlace 3", "default": "Feed" },
    { "type": "text", "id": "col3", "label": "Título columna 3", "default": "Contacto" },
    { "type": "text", "id": "col3_wa", "label": "Texto del WhatsApp", "default": "WhatsApp +57 320 722 4241" },
    { "type": "text", "id": "col3_envio", "label": "Texto del envío", "default": "Envío gratis desde 2 gorras" },
    { "type": "text", "id": "col4", "label": "Título columna 4", "default": "Redes" },
    { "type": "text", "id": "copyright", "label": "Derechos (el año se pone solo)", "default": "CrowCaps. Todos los derechos reservados." }
  ]
}
{% endschema %}
