{%- liquid
  capture wa_general
    render 'cc-wa', mensaje: settings.mensaje_general
  endcapture
  assign raiz = routes.root_url
  if raiz == '/'
    assign raiz = ''
  endif
  # En la portada el enlace lleva solo el ancla: así no se recarga la página
  # (los anuncios traen ?fbclid=… y /#coleccion cargaría todo de nuevo)
  assign ancla = raiz | append: '/'
  if template.name == 'index'
    assign ancla = ''
  endif
-%}
{%- if section.settings.aviso_visible and section.settings.aviso_texto != blank -%}
<!-- ============ FRANJA DE ENVÍO ============ -->
<p class="topbar" id="topbar">{{ section.settings.aviso_texto | escape }}</p>
{%- endif %}

<!-- ============ NAV ============ -->
<header class="nav" id="nav">
  <a class="nav__logo" href="{% if template.name == 'index' %}#top{% else %}{{ routes.root_url }}{% endif %}" aria-label="{{ settings.marca_nombre | escape }}, inicio">
    <img class="lg-paper" src="{{ 'cc-wordmark.webp' | asset_url }}" width="87" height="32" alt="{{ settings.marca_nombre | escape }}">
    <img class="lg-ink" src="{{ 'cc-wordmark-ink.webp' | asset_url }}" width="87" height="32" alt="" aria-hidden="true">
  </a>
  <nav class="nav__menu" aria-label="Principal">
    <a href="{{ ancla }}#coleccion">{{ section.settings.nav_coleccion | escape }}</a>
    <a href="{{ ancla }}#marca">{{ section.settings.nav_marca | escape }}</a>
    <a href="{{ ancla }}#feed">{{ section.settings.nav_feed | escape }}</a>
  </nav>
  <div class="nav__right">
    <a class="btn btn--sm" href="{{ wa_general }}" target="_blank" rel="noopener">{{ section.settings.nav_cta | escape }} <span class="arw" aria-hidden="true">→</span></a>
    <a class="nav__cart" id="cartBtn" href="{{ routes.cart_url }}" aria-label="Carrito, {{ cart.item_count }} {% if cart.item_count == 1 %}gorra{% else %}gorras{% endif %}">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
      <b class="nav__cart-n" id="cartCount"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</b>
    </a>
    <button class="burger" id="burger" aria-expanded="false" aria-controls="mmenu" aria-label="Abrir menú"><i></i><i></i></button>
  </div>
</header>

<div class="mmenu" id="mmenu">
  <nav aria-label="Menú móvil">
    <a href="{{ ancla }}#coleccion" data-close>{{ section.settings.nav_coleccion | escape }}</a>
    <a href="{{ ancla }}#marca" data-close>{{ section.settings.nav_marca | escape }}</a>
    <a href="{{ ancla }}#feed" data-close>{{ section.settings.nav_feed | escape }}</a>
    <a href="{{ ancla }}#contacto" data-close>{{ section.settings.nav_contacto | escape }}</a>
  </nav>
  <div class="mmenu__foot">
    <a class="btn btn--light" href="{{ wa_general }}" target="_blank" rel="noopener">{{ settings.texto_pedir | escape }} <span class="arw" aria-hidden="true">→</span></a>
    <div class="mmenu__soc">
      {%- if settings.instagram_url != blank %}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
      {%- if settings.tiktok_url != blank %}<a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener">TikTok</a>{% endif %}
      <span>{{ section.settings.menu_ciudad | escape }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Encabezado",
  "class": "cc-header",
  "settings": [
    { "type": "header", "content": "Franja de arriba" },
    { "type": "checkbox", "id": "aviso_visible", "label": "Mostrar la franja", "default": true },
    { "type": "text", "id": "aviso_texto", "label": "Texto de la franja", "default": "Envío gratis a partir de 2 gorras" },
    { "type": "header", "content": "Menú" },
    { "type": "text", "id": "nav_coleccion", "label": "Enlace a la colección", "default": "Colección" },
    { "type": "text", "id": "nav_marca", "label": "Enlace a la marca", "default": "Marca" },
    { "type": "text", "id": "nav_feed", "label": "Enlace al feed", "default": "Feed" },
    { "type": "text", "id": "nav_contacto", "label": "Enlace a contacto (solo celular)", "default": "Contacto" },
    { "type": "text", "id": "nav_cta", "label": "Botón de WhatsApp", "default": "Comprar" },
    { "type": "text", "id": "menu_ciudad", "label": "Ciudad en el menú del celular", "default": "Medellín · CO" }
  ]
}
{% endschema %}
