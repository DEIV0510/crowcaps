{%- comment -%}
  Enlace de WhatsApp de una gorra concreta. El mensaje admite {producto},
  {equipo}, {precio} y {enlace}. El enlace a la gorra se añade al final aunque el
  mensaje no lo pida: es lo que hace que WhatsApp muestre la foto en el chat.
{%- endcomment -%}
{%- capture salto %}
{% endcapture -%}
{%- assign pesos = p.price | divided_by: 100 -%}
{%- capture precio -%}{%- render 'cc-cop', valor: pesos -%}{%- endcapture -%}
{%- liquid
  assign enlace = shop.url | append: p.url
  assign msg = settings.mensaje_producto | replace: '{producto}', p.title | replace: '{equipo}', p.vendor | replace: '{precio}', precio
  if msg contains '{enlace}'
    assign msg = msg | replace: '{enlace}', enlace
  else
    assign msg = msg | strip | append: salto | append: enlace
  endif
-%}
{%- render 'cc-wa', mensaje: msg -%}
